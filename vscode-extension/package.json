{
  "name": "minab-vscode",
  "displayName": "Minab",
  "description": "Syntax highlighting and live diagnostics for Minab (.minab) files",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:minab"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "minab",
        "extensions": [".minab"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "minab",
        "scopeName": "source.minab",
        "path": "./syntaxes/minab.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.85.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
