{
  "name": "minab-example-nestjs",
  "version": "0.0.0",
  "private": true,
  "description": "A NestJS app that runs stored Minab programs: a validation rule inside a request transaction, a stored query and the run endpoint",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "npm run build && node dist/migrate.js",
    "start": "npm run build && node dist/main.js",
    "test": "jest --config test/jest.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.9.0"
  }
}
