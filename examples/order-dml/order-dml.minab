// Declarative writes (spec §10, showcase §13): UPDATE with an inline filter
// and a compound `+:` operator, then an INSERT from a filtered table.
//
// CHECK-ONLY: `INSERT`/`UPDATE`/`DELETE` parse, resolve, and type-check, but
// execution is not built yet (ADR 0001 settles how it will work).
//
//   minab check order-dml.minab

UPDATE #Customer[.country == "TR"]
SET { checked: true, points +: 10 };

INSERT #Archive
VALUES #Customer[.country == "TR"];

true
