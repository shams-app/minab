    {
      "name": "a date part in a set filter reads the user",
      "source": "@currentUser IN @@everyone[YEAR(.joinedAt) == 2026]",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "member",
