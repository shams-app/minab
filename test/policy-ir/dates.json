            "special": "currentUser"
          },
          "set": {
            "k": "filter",
            "set": {
              "k": "everyone"
            },
            "where": {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "fn": "YEAR",
                "args": [
                  {
                    "prin": [
                      "joinedAt"
                    ]
                  }
                ]
              },
              "r": {
                "lit": 2026,
                "t": "INTEGER"
              }
            }
          }
