{
  "topic": "directory-functions",
  "cases": [
    {
      "name": "findUser by e-mail",
      "source": "@currentUser == findUser('sara@example.com')",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "cmp",
          "cmp": "eq",
          "l": {
            "prin": [
              "id"
            ]
          },
          "r": {
            "lit": "usr_sara",
            "t": "USER"
          }
        }
      }
    },
    {
