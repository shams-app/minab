    {
      "name": "findUser is not another user",
      "source": ".owner != findUser('ali@example.com')",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "not",
          "x": {
            "op": "cmp",
            "cmp": "eq",
            "l": {
              "res": [
                "owner"
              ]
            },
            "r": {
              "lit": "usr_ali",
              "t": "USER"
            }
          }
        }
      }
    },
    {
      "name": "findUser in a set",
      "source": "@currentUser IN findUser('sara@example.com') + @@Interns",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "member",
          "user": {
            "special": "currentUser"
          },
          "set": {
            "k": "union",
            "of": [
              {
                "k": "user",
                "id": "usr_sara"
              },
              {
                "k": "group",
                "id": "grp_Interns"
              }
            ]
          }
        }
      }
    },
    {
      "name": "findGroup",
      "source": "@currentUser IN findGroup('Sales')",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "member",
          "user": {
            "special": "currentUser"
          },
          "set": {
            "k": "group",
            "id": "grp_Sales"
          }
        }
      }
    },
    {
      "name": "single of a filter",
      "source": "@currentUser == single(@@everyone[.city == 'Tehran'])",
      "kind": "boolean",
      "expected": false,
      "ir": {
        "v": 1,
        "condition": {
          "op": "member",
          "user": {
            "special": "currentUser"
          },
          "set": {
            "k": "one",
            "user": {
              "k": "single",
              "set": {
                "k": "filter",
                "set": {
                  "k": "everyone"
                },
                "where": {
                  "op": "cmp",
                  "cmp": "eq",
                  "l": {
                    "prin": [
                      "city"
                    ]
                  },
                  "r": {
                    "lit": "Tehran",
                    "t": "TEXT"
                  }
                }
              },
              "orNull": false
            }
          }
        }
      }
    },
    {
      "name": "single is the one user",
      "source": "single(@@everyone[.city == 'Tehran']) == findUser('usr_mina')",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "member",
          "user": {
            "k": "single",
            "set": {
              "k": "filter",
              "set": {
                "k": "everyone"
              },
              "where": {
                "op": "cmp",
                "cmp": "eq",
                "l": {
                  "prin": [
                    "city"
                  ]
                },
                "r": {
                  "lit": "Tehran",
                  "t": "TEXT"
                }
              }
            },
            "orNull": false
          },
          "set": {
            "k": "user",
            "id": "usr_mina"
          }
        }
      }
    },
