    {
      "name": "is null on an empty user field",
      "source": ".reviewer is null",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "isNull",
          "x": {
            "res": [
              "reviewer"
            ]
          }
        }
      }
    },
    {
      "name": "a user field that is null: is null with another test",
      "source": ".reviewer is null AND .status == 'open'",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "and",
          "of": [
            {
              "op": "isNull",
              "x": {
                "res": [
                  "reviewer"
                ]
              }
            },
            {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "res": [
                  "status"
                ]
              },
              "r": {
                "lit": "open",
                "t": "TEXT"
              }
            }
          ]
        }
      }
    },
    {
      "name": "an empty user compared with a user is false",
      "source": ".reviewer == @currentUser",
      "kind": "boolean",
      "expected": false,
      "ir": {
        "v": 1,
        "condition": {
          "op": "cmp",
          "cmp": "eq",
