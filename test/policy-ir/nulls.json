{
  "topic": "nulls",
  "cases": [
    {
      "name": "a null field is an ordinary value: == is false",
      "source": ".note == 'x'",
      "kind": "boolean",
      "expected": false,
      "ir": {
        "v": 1,
        "condition": {
          "op": "cmp",
          "cmp": "eq",
          "l": {
            "res": [
              "note"
            ]
          },
          "r": {
            "lit": "x",
            "t": "TEXT"
          }
        }
      }
    },
    {
      "name": "a null field is an ordinary value: != is true",
      "source": ".note != 'x'",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "cmp",
          "cmp": "ne",
          "l": {
            "res": [
              "note"
            ]
          },
          "r": {
            "lit": "x",
            "t": "TEXT"
          }
        }
      }
    },
    {
      "name": "a false comparison with a null field makes the and false",
      "source": ".id == 1 AND .note == 'x'",
      "kind": "boolean",
      "expected": false,
      "ir": {
        "v": 1,
        "condition": {
          "op": "and",
          "of": [
            {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "res": [
                  "id"
                ]
              },
              "r": {
                "lit": 1,
                "t": "INTEGER"
              }
            },
            {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "res": [
                  "note"
                ]
              },
              "r": {
                "lit": "x",
                "t": "TEXT"
              }
            }
          ]
        }
      }
    },
    {
