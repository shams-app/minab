                "res": [
                  "note"
                ]
              },
              "r": {
                "lit": "x",
                "t": "TEXT"
              }
            }
          ]
        }
      }
    },
    {
      "name": "or with a null comparison: true",
      "source": ".id == 7 OR .note == 'x'",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "or",
          "of": [
            {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "res": [
                  "id"
                ]
              },
              "r": {
                "lit": 7,
                "t": "INTEGER"
              }
            },
            {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "res": [
                  "note"
                ]
              },
              "r": {
                "lit": "x",
                "t": "TEXT"
              }
            }
          ]
        }
      }
    },
    {
      "name": "or with a null comparison: false",
      "source": ".id == 1 OR .note == 'x'",
      "kind": "boolean",
      "expected": false,
      "ir": {
        "v": 1,
        "condition": {
          "op": "or",
          "of": [
            {
              "op": "cmp",
