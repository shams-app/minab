            }
          ]
        }
      }
    },
    {
      "name": "not of a comparison with null is true",
      "source": ".id == 7 AND NOT .note == 'x'",
      "kind": "boolean",
      "expected": true,
      "ir": {
        "v": 1,
        "condition": {
          "op": "and",
          "of": [
            {
              "op": "cmp",
              "cmp": "eq",
              "l": {
                "res": [
                  "id"
                ]
              },
              "r": {
                "lit": 7,
                "t": "INTEGER"
              }
            },
            {
              "op": "not",
              "x": {
                "op": "cmp",
                "cmp": "eq",
                "l": {
                  "res": [
                    "note"
