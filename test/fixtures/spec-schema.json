{
  "tables": [
    {
      "name": "Customer",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "name": "TEXT",
        "country": "TEXT?",
        "city": "TEXT",
        "tier": "TEXT",
        "credit_limit": "DECIMAL",
        "discount_rate": "DECIMAL",
        "tags": "JSON",
        "metadata": "JSON",
        "orders": { "collection": "Order", "foreignKey": "customer_id" }
      }
    },
    {
      "name": "Order",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "customer": { "ref": "Customer", "foreignKey": "customer_id" },
        "customer_id": "UUID",
        "status": "TEXT",
        "total": "DECIMAL",
        "discount_rate": "DECIMAL",
        "tracking_code": "TEXT",
        "placed_at": "DATETIME"
      }
    },
    {
      "name": "Customers",
      "primaryKey": "id",
      "columns": { "id": "UUID", "balance": "DECIMAL", "metadata": "JSON", "status": "TEXT", "flaggedAt": "INTEGER", "city": "TEXT" }
    },
    {
      "name": "CollectionsQueue",
      "primaryKey": "id",
      "columns": { "id": "UUID", "customer_id": "UUID", "reason": "TEXT" }
    },
    {
      "name": "Payment",
      "primaryKey": "id",
      "columns": { "id": "UUID", "customer_id": "UUID", "days_ago": "INTEGER" }
    },
    {
      "name": "Shipment",
      "primaryKey": "id",
      "columns": {
        "id": "UUID",
        "order_id": "UUID",
        "tracking_code": "TEXT",
        "status": "TEXT",
        "delivered_at": "DATETIME?"
      }
    },
    {
      "name": "Product",
      "primaryKey": "id",
      "columns": { "id": "UUID", "name": "TEXT" }
    },
    {
      "name": "Warehouse",
      "primaryKey": "id",
      "columns": { "id": "UUID", "name": "TEXT", "default_product_id": "UUID" }
    },
    {
      "name": "Booking",
      "primaryKey": "id",
      "columns": { "id": "UUID", "room_id": "UUID", "start_date": "DATE", "end_date": "DATE" }
    }
  ]
}
