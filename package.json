{
  "name": "@shamsine/minab",
  "version": "0.2.0",
  "description": "Minab — a pipeline query and validation language, implemented with Langium",
  "license": "MIT",
  "author": "Hamed Zakery Miab",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shams-app/minab.git"
  },
  "keywords": [
    "minab",
    "query-language",
    "validation",
    "langium",
    "language-server",
    "cli"
  ],
  "type": "module",
  "bin": {
    "minab": "./out/src/cli/bin.js"
  },
  "files": [
    "out/src",
    "!out/src/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch",
    "build": "npm run langium:generate && tsc -b tsconfig.json",
    "watch": "concurrently -k -r \"npm:langium:watch\" \"npm:build:watch\"",
    "build:watch": "tsc -b tsconfig.json --watch",
    "cli": "node out/src/cli/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:release": "langium generate && rm -rf out && tsc -b tsconfig.build.json",
    "prepack": "npm run build:release"
  },
  "dependencies": {
    "langium": "~4.4.0",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.0.0",
    "langium-cli": "~4.4.0",
    "pg": "^8.23.0",
    "typescript": "~5.9.3",
    "vitest": "~5.0.0"
  }
}
